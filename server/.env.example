# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to server/.env and fill in your values.
# server/.env is private (ignored by Git) — never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# Port the API server listens on. The React dev server reads this too.
# On Windows, 5000 is often reserved by Hyper-V/WSL — 5050 is a safe choice.
PORT=5050

# Secret used to sign login tokens. Use a long random string, e.g. generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# DeepSeek API key (https://platform.deepseek.com). Leave empty to use the
# built-in metrics-based fallback analysis instead of AI.
DEEPSEEK_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Full path to Chrome if it isn't found automatically
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Where the SQLite database is stored (default: server/data/audit_history.db)
# DB_PATH=

# Scratch folder for Chrome during audits (default: <project>/temp)
# TEMP_DIR=

# Set to "production" to make the server also serve the built dashboard
# NODE_ENV=production
